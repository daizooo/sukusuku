<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- 授乳中だけ動く前面サービス。画面が消えていてもアプリを閉じていても鳴らすために要る。 -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Android 13以降、常駐通知を出すのに実行時の許可が要る。 -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- 経過時間の区切りごとの振動。 -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- 画面が消えている間もサービスが数え続けられるように。 -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- 夜間の起床アラーム（docs/night-wake-alarm.md）。再起動で消えた予約を掛け直すために要る。 -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- AlarmManager.setAlarmClock で起床アラームを予約するために要る。無いと SecurityException で
       予約できない（Android 12以降。実機で確認した）。
       - Android 13以降: USE_EXACT_ALARM。インストール時に自動で許可され、利用者の操作は要らない。
         ストアでは目覚まし・カレンダー用途のアプリに限られるが、このアプリはストアに出さず
         .apk を自分たちの端末に直接入れる（docs/store-release.md）ので使える。
       - Android 12/12L: SCHEDULE_EXACT_ALARM。この版では初期状態で許可されている。
         13以降では利用者の設定が要るので maxSdkVersion で外す。 -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
  <uses-permission
    android:name="android.permission.SCHEDULE_EXACT_ALARM"
    android:maxSdkVersion="32" />

  <application>
    <service
      android:name="com.sukusuku.nursingalarm.NursingAlarmService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <!-- 既存の型（位置情報・再生・通話…）のどれにも当たらないため specialUse を使う。
           ストアには出さない（.apkを自分たちの端末に直接入れる）ので審査の説明は要らない。 -->
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="授乳の経過時間を数え、区切りごとに音と振動で知らせる" />
    </service>

    <!-- 夜間の起床アラーム。予約の発火で WakeAlarmReceiver が WakeAlarmService を始める。 -->
    <service
      android:name="com.sukusuku.nursingalarm.WakeAlarmService"
      android:enabled="true"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="夜の授乳の少し前に、起きるための音を鳴らす" />
    </service>

    <!-- サーバーからの起床アラームの予約の入れ替えを受け取る（WakeSyncMessagingService）。
         expo-notifications のサービス（優先度 -1）より先に受け取るため、既定の優先度（0）にする。
         起床アラーム以外のメッセージは、そのサービスへ渡す。 -->
    <service
      android:name="com.sukusuku.nursingalarm.WakeSyncMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <receiver
      android:name="com.sukusuku.nursingalarm.WakeAlarmReceiver"
      android:enabled="true"
      android:exported="false" />

    <receiver
      android:name="com.sukusuku.nursingalarm.WakeAlarmBootReceiver"
      android:enabled="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>

</manifest>
