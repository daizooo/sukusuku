{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // process.env(EXPO_PUBLIC_*)の型解決に要る。無いと `process` が未定義扱いになる。
    "types": ["node"],
    // テスト(*.test.ts)は `node --experimental-strip-types` で直に動かすため、
    // import のパスに拡張子(.ts)が要る。ここはビルド出力を作らない(noEmit)ので許可できる。
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // .expo/types と expo-env.d.ts は typed routes を使うときだけ生成される（使っていない）。
  // ここに書いておくと npm run android のたびにExpoが取り除き、ついでにこのファイルの
  // コメントまで消して書き直すので、最初から入れない。
  "include": ["**/*.ts", "**/*.tsx"]
}
